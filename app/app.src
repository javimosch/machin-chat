// app.src — Chat: live room chat over machin-rooms (ws://).
// Room + name fields, Connect/Send, message list. Server: $MDK_CHAT_SERVER
// or ws://127.0.0.1:48500 (run `machin-rooms` first).

func msg_row(m) {
    i := row()
    fillw()
    gap(8.0)
    align(A_START)
    if m.kind == "sys" {
        center()
        text(m.text, 12.0)
        fg(C_MUTED)
    } else {
        col()
        gap(1.0)
            text(m.name, 12.0)
            bold()
            fg(C_ACCENT)
        end()
        text(m.text, 14.0)
    }
    end()
}

func view() {
    chat_poll()
    if g_needs_connect == 1 { chat_connect() }

    col()
    fill()
    pad(20.0)
    gap(12.0)
        row()
        fillw()
        gap(12.0)
            text("Chat", 24.0)
            bold()
            spacer()
            badge(chat_status_label(), chat_status_color())
        end()

        row()
        gap(8.0)
            text("room", 12.0)
            fg(C_MUTED)
            text_field("room", "general")
            width(90.0)
            text("name", 12.0)
            fg(C_MUTED)
            text_field("name", "you")
            width(120.0)
            if button("Connect") { chat_connect() }
        end()

        sv := scroll_view("msgs")
        fill()
        gap(4.0)
            n := hist_len()
            if n == 0 {
                col()
                fillw()
                center()
                pad(40.0)
                    if g_status == ST_ONLINE {
                        text("Say hi — messages appear here", 14.0)
                    } else {
                        text("Connect to a room to start chatting", 14.0)
                    }
                    fg(C_MUTED)
                end()
            }
            i := 0
            while i < n {
                msg_row(hist_get(i))
                i = i + 1
            }
        end()

        row()
        gap(10.0)
            draft := text_field("msg", "Message…")
            fillw()
            if button("Send") || (focused("msg") && key(K_RETURN)) {
                if chat_send(draft) {      // the draft stays if it wasn't sent
                    set_str("msg", "")
                    set_int("msg:caret", 0)
                }
            }
        end()
    end()
}
