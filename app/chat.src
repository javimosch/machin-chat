// chat.src — connection + message handling for machin-chat.
// A reader goroutine owns the socket (wsc_recv blocks); the UI thread
// only sends and drains g_ch via non-blocking select each frame.
// wsclient.src (wsc_*) provides the ws:// client — the hand-rolled ws.src
// was retired because its ws_close() shadowed the new ws_* builtin.
//
// Protocol (machin-rooms): client sends plain text; server broadcasts
// {"type":"msg","name":..,"text":..} and {"type":"sys","text":..,"count":N}.
// Endpoint: ws://127.0.0.1:48500/ws?room=<r>&name=<n>
// Override server with $MDK_CHAT_SERVER (e.g. ws://host:48500).
// Live-only for now — no history/persistence yet (bkn events is the
// natural fit later).

type ChatMsg struct { kind string  name string  text string }

// Release builds sleep in SDL_WaitEventTimeout(-1) until an SDL event
// arrives, and socket traffic raises none — so the reader pushes a user
// event per message to wake the wait; the next frame's chat_poll() then
// drains the queue. SDL_PushEvent is thread-safe and needs no SDL headers:
// the symbols are already linked into the host (static SDL3 in release,
// exported by the -rdynamic dev host for the dlopened .so).
extern "c" {
    fn SDL_RegisterEvents(int) int
    fn SDL_PushEvent(int) int
}

var g_ws = WSClient{fd: -1, buf: []bytes{}}   // owned by the reader goroutine; UI only reads fd for send
var g_ch = make(chan string)   // unbounded: sends never block, so the reader can't stall on a full UI queue
var g_wake_ty = 0
var g_wake_ev = 0
var g_status = "idle"      // idle | connecting | online | offline
var g_msgs = []ChatMsg{}
var g_needs_connect = 1

func jstr(j, path) {
    v, e := json_get(j, path)
    if e != "" { return "" }
    return parse(v, "")
}

func chat_server() {
    s := env("MDK_CHAT_SERVER")
    if s == "" { return "ws://127.0.0.1:48500" }
    return s
}

func chat_url() {
    room := state_str("room", "general")
    name := state_str("name", "you")
    return chat_server() + "/ws?room=" + room + "&name=" + name
}

func chat_wake() {
    if g_wake_ev == 0 {
        g_wake_ty = SDL_RegisterEvents(1)
        g_wake_ev = alloc(128)   // sizeof(SDL_Event); SDL_copyp's the whole union
    }
    if g_wake_ty == 0 { return }
    poke_i32(g_wake_ev, 0, g_wake_ty)   // common.type (Uint32 @ 0)
    poke_i64(g_wake_ev, 8, 0)           // common.timestamp (@ 8) — let SDL stamp it
    SDL_PushEvent(g_wake_ev)
}

// chat_url() -> (host, port, path): wsc_open takes the parts, not the URL.
func chat_ws_endpoint() (host, port, path) {
    rest := chat_url()
    if has_prefix(rest, "ws://") { rest = substr(rest, 5, len(rest)) }
    slash := index(rest, "/")
    hostport := rest
    path = "/"
    if slash >= 0 { hostport = substr(rest, 0, slash)  path = substr(rest, slash, len(rest)) }
    host = hostport
    port = 80
    colon := index(hostport, ":")
    if colon >= 0 {
        host = substr(hostport, 0, colon)
        port = parse_int(substr(hostport, colon+1, len(hostport)))
    }
}

func chat_reader() {
    g_status = "connecting"
    host, port, path := chat_ws_endpoint()
    c, ok := wsc_open(host, port, path)
    if ok == 0 { g_status = "offline"  return }
    g_ws = c
    g_status = "online"
    while true {
        msg, mok := wsc_recv(c)
        if mok == 0 { break }
        g_ch <- msg
        chat_wake()
    }
    wsc_close(c)
    g_ws = WSClient{fd: -1, buf: []bytes{}}
    g_status = "offline"
}

func chat_connect() {
    g_needs_connect = 0
    g_msgs = []ChatMsg{}
    go chat_reader()
}

func chat_send(text) {
    t := trim(text)
    if t == "" || g_status != "online" { return }
    wsc_send(g_ws, t)
}

func chat_status_label() {
    if g_status == "online" { return "online" }
    if g_status == "connecting" { return "connecting…" }
    if g_status == "offline" { return "offline" }
    return "idle"
}

func chat_status_color() {
    if g_status == "online" { return C_ACCENT }
    if g_status == "connecting" { return C_MUTED }
    return C_DANGER
}

func handle_msg(raw) {
    ty := jstr(raw, ".type")
    if ty == "msg" {
        g_msgs = append(g_msgs, ChatMsg{kind: "msg",
            name: jstr(raw, ".name"), text: jstr(raw, ".text")})
    } else if ty == "sys" {
        g_msgs = append(g_msgs, ChatMsg{kind: "sys",
            name: "", text: jstr(raw, ".text")})
    }
    // cap history — drop oldest beyond 500
    if len(g_msgs) > 500 {
        keep := []ChatMsg{}
        i := len(g_msgs) - 500
        while i < len(g_msgs) { keep = append(keep, g_msgs[i])  i = i + 1 }
        g_msgs = keep
    }
}

// drain every queued socket message; call once per frame
func chat_poll() {
    draining := true
    while draining {
        draining = false
        select {
        case raw := <-g_ch:
            handle_msg(raw)
            draining = true
        default:
        }
    }
}
