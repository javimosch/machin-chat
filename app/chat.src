// chat.src — connection + message handling for machin-chat.
// The socket side is in net.src: it runs in goroutines and reports on g_ch,
// which the UI thread drains via non-blocking select each frame. wsclient.src
// (wsc_*) provides the ws:// client.
//
// Protocol (machin-rooms): client sends plain text; server broadcasts
// {"type":"msg","name":..,"text":..} and {"type":"sys","text":..,"count":N}.
// Endpoint: ws://127.0.0.1:48500/ws?room=<r>&name=<n> (percent-encoded)
// Override server with $MDK_CHAT_SERVER (e.g. ws://host:48500).
// Live-only for now — no history/persistence yet (bkn events is the
// natural fit later).

// machin-rooms' limits, in bytes: it cuts longer room and user names, and
// closes the connection on a longer message
var MAX_ROOM = 64
var MAX_NAME = 32
var MAX_MESSAGE = 131072

// Release builds sleep in SDL_WaitEventTimeout(-1) until an SDL event
// arrives, and socket traffic raises none — so the reader pushes a user
// event per message to wake the wait; the next frame's chat_poll() then
// drains the queue. SDL_PushEvent is thread-safe and needs no SDL headers:
// the symbols are already linked into the host (static SDL3 in release,
// exported by the -rdynamic dev host for the dlopened .so).
extern "c" {
    fn SDL_RegisterEvents(int) int
    fn SDL_PushEvent(int) int
}

var g_fd = -1       // the current connection, once open
var g_gen = 0       // bumped by each connect; events from older ones are ignored
var g_wake_ty = 0
var g_wake_ev = 0
var g_status = 0    // ST_*; an int, as are all globals the frame assigns (see history.src)
var g_needs_connect = 1

var ST_IDLE = 0
var ST_CONNECTING = 1
var ST_ONLINE = 2
var ST_OFFLINE = 3

func jstr(j, path) {
    v, e := json_get(j, path)
    if e != "" { return "" }
    return parse(v, "")
}

func chat_server() {
    s := env("MDK_CHAT_SERVER")
    if s == "" { return "ws://127.0.0.1:48500" }
    return s
}

// clip_utf8 cuts s to at most max bytes without splitting a character
// (the same cut machin-rooms makes).
func clip_utf8(s, max) (r) {
    r = s
    if len(s) <= max { return }
    b := bytes(substr(s, 0, max + 1))
    n := max
    while n > 0 && (byte_at(b, n) & 192) == 128 { n = n - 1 }
    r = substr(s, 0, n)
}

// What a room/name field means: empty means the placeholder it shows. A value
// the server would cut is cut here too, and written back so the field shows it.
// The state default must be "", the same as text_field's: the first read of a
// key sets it.
func chat_field(k, fallback, max) {
    v := state_str(k, "")
    c := clip_utf8(trim(v), max)
    if c != v { set_str(k, c) }
    if c == "" { return fallback }
    return c
}

func chat_url() {
    room := chat_field("room", "general", MAX_ROOM)
    name := chat_field("name", "you", MAX_NAME)
    return chat_server() + "/ws?room=" + url_encode(room) + "&name=" + url_encode(name)
}

func chat_wake() {
    if g_wake_ty == 0 { return }
    poke_i32(g_wake_ev, 0, g_wake_ty)   // common.type (Uint32 @ 0)
    poke_i64(g_wake_ev, 8, 0)           // common.timestamp (@ 8) — let SDL stamp it
    SDL_PushEvent(g_wake_ev)
}

// chat_url() -> (host, port, path): wsc_open takes the parts, not the URL.
func chat_ws_endpoint() (host, port, path) {
    rest := chat_url()
    if has_prefix(rest, "ws://") { rest = substr(rest, 5, len(rest)) }
    slash := index(rest, "/")
    hostport := rest
    path = "/"
    if slash >= 0 { hostport = substr(rest, 0, slash)  path = substr(rest, slash, len(rest)) }
    host = hostport
    port = 80
    colon := index(hostport, ":")
    if colon >= 0 {
        host = substr(hostport, 0, colon)
        port = parse_int(substr(hostport, colon+1, len(hostport)))
    }
}

// UI thread only, like everything below: the state store is not thread-safe.
func chat_connect() {
    g_needs_connect = 0
    net_init()
    // allocated here, once, so that readers only ever reuse it
    if g_wake_ev == 0 {
        g_wake_ty = SDL_RegisterEvents(1)
        g_wake_ev = alloc(128)   // sizeof(SDL_Event); SDL_copyp's the whole union
    }
    if g_fd >= 0 {
        net_drop(g_fd)
        g_fd = -1
    }
    g_gen = g_gen + 1
    hist_clear()
    g_status = ST_CONNECTING
    host, port, path := chat_ws_endpoint()
    go net_dial(g_gen, host, port, path)
}

// -> true if the message was sent
func chat_send(text) {
    t := trim(text)
    if t == "" || g_status != ST_ONLINE { return false }
    if len(t) > MAX_MESSAGE {
        hist_add("sys", "", "not sent: " + str(len(t)) + " bytes, the limit is " + str(MAX_MESSAGE))
        return false
    }
    return net_write(g_fd, 1, bytes(t)) == 1
}

func chat_status_label() {
    if g_status == ST_ONLINE { return "online" }
    if g_status == ST_CONNECTING { return "connecting…" }
    if g_status == ST_OFFLINE { return "offline" }
    return "idle"
}

func chat_status_color() {
    if g_status == ST_ONLINE { return C_ACCENT }
    if g_status == ST_CONNECTING { return C_MUTED }
    return C_DANGER
}

func handle_msg(raw) {
    ty := jstr(raw, ".type")
    if ty == "msg" {
        hist_add("msg", jstr(raw, ".name"), jstr(raw, ".text"))
    } else if ty == "sys" {
        hist_add("sys", "", jstr(raw, ".text"))
    }
}

func chat_event(ev) {
    current := ev.gen == g_gen
    if ev.kind == NET_OPEN {
        if current {
            g_fd = ev.fd
            g_status = ST_ONLINE
        } else {
            net_drop(ev.fd)   // replaced while still connecting
        }
    } else if ev.kind == NET_MSG {
        if current { handle_msg(ev.data) }
    } else if ev.kind == NET_CLOSED {
        if ev.fd >= 0 { close(ev.fd) }
        if current {
            g_fd = -1
            g_status = ST_OFFLINE
        }
    }
}

// drain queued socket events; call once per frame. At most 200 a frame, so a
// flood can neither stop the window drawing nor grow the frame's arena.
func chat_poll() {
    n := 0
    draining := true
    while draining && n < 200 {
        draining = false
        select {
        case ev := <-g_ch:
            chat_event(ev)
            n = n + 1
            draining = true
        default:
        }
    }
    if draining { animate() }
}
